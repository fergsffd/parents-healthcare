[Unit]
Description=PHC auto-commit: commit and push changed datafiles
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/myClaude/parents-healthcare
ExecStart=/usr/bin/python3 %h/myClaude/parents-healthcare/utilities/phc_autocommit.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=phc-autocommit
